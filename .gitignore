# Virtual Environment
.venv/
env/
venv/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pkl
.cache_*

# Logs & Testing
*.log
logs/
.pytest_cache/

# Processed & Temporary output
data/processed/*
!data/processed/.gitkeep
data/inbox/*
!data/inbox/.gitkeep
reports/*.xlsx
!reports/.gitkeep

# Raw customer uploads (never track in git)
data/raw/orders/*
!data/raw/orders/.gitkeep
data/raw/payments/*
!data/raw/payments/.gitkeep
data/raw/master/*
!data/raw/master/.gitkeep

# Databases & local configs
data/recon.db
data/test_*.db
.env
